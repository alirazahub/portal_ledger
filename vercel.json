{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/login",
      "destination": "/"
    },
    {
      "source": "/login/",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portal-ledger\\.aliraza\\.fr"
        }
      ],
      "destination": "https://ledger.aliraza.fr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "portal-ledger\\.vercel\\.app"
        }
      ],
      "destination": "https://ledger.aliraza.fr/:path*",
      "permanent": true
    }
  ]
}